        <dc:Bounds x="1420" y="620" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ShipMerge_di" bpmnElement="Gateway_ShipMerge" isMarkerVisible="true">
        <dc:Bounds x="1575" y="635" width="50" height="50" />
      </bpmndi:BPMNShape>
