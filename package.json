{
  "name": "em-cli",
  "version": "1.0.0",
  "description": "Event Modeling board served over HTTP",
  "type": "module",
  "bin": {
    "em-cli": "cli/index.js"
  },
  "files": [
    "cli/index.js",
    "cli/init.js",
    "cli/agent/agent.js",
    "cli/agent/modeling-task-prompt.md",
    "cli/agent/harnesses",
    "cli/board/app.js",
    "cli/board/api.js",
    "cli/board/agent-api.js",
    "cli/board/build-queue.js",
    "cli/board/modeling-tasks.js",
    "cli/board/http-error.js",
    "cli/board/field-inheritance.js",
    "cli/board/model-edit.js",
    "cli/board/model-rules.js",
    "cli/board/model-store.js",
    "cli/board/html-compact.js",
    "cli/board/html-highlights.js",
    "cli/board/lane-colors.js",
    "cli/board/public",
    ".claude/skills"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -k -n server,board -c blue,green \"node --watch cli/index.js board --dev\" \"vite event-modeling-board\"",
    "build": "vite build --config event-modeling-board/vite.config.js",
    "start": "node cli/index.js board",
    "prepack": "npm run build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "parse5": "^8.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "concurrently": "^10.0.7",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7"
  }
}
