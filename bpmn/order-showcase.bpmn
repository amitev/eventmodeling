      <bpmndi:BPMNEdge id="Flow_Auto_di" bpmnElement="Flow_Auto">
        <di:waypoint x="1365" y="660" />
        <di:waypoint x="1420" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1362" y="642" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1520" y="480" />
        <di:waypoint x="1600" y="480" />
        <di:waypoint x="1600" y="635" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1520" y="660" />
        <di:waypoint x="1575" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1625" y="660" />
        <di:waypoint x="1692" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1710" y="642" />
        <di:waypoint x="1710" y="480" />
        <di:waypoint x="1790" y="480" />
