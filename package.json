{
  "name": "em-cli",
  "version": "1.0.0",
  "description": "Event Modeling board served over HTTP",
  "type": "module",
  "bin": {
    "em-cli": "server/index.js"
  },
  "files": [
    "server/index.js",
    "server/app.js",
    "server/api.js",
    "server/http-error.js",
    "server/model-edit.js",
    "server/model-rules.js",
    "server/model-store.js",
    "server/html-compact.js",
    "server/init.js",
    "server/public",
    ".claude/skills"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -k -n server,board -c blue,green \"node --watch server/index.js --dev\" \"vite event-modeling-board\"",
    "build": "vite build --config event-modeling-board/vite.config.js",
    "start": "node server/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "parse5": "^8.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "concurrently": "^10.0.7",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7"
  }
}
