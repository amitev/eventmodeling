<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Order_showcase" targetNamespace="http://eventmodeling/showcase/order-showcase">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Carrier" name="Carrier" />
    <bpmn:participant id="Participant_Order" name="Order showcase" processRef="Process_Order" />
    <bpmn:participant id="Participant_Payment" name="Payment provider" />
    <bpmn:messageFlow id="Msg_PaymentStatus" name="Payment status" sourceRef="Participant_Payment" targetRef="Task_RecordPayment" />
    <bpmn:messageFlow id="Msg_ParcelHandedOver" name="Parcel handed over" sourceRef="Participant_Carrier" targetRef="Task_TrackShipment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Order" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Shopper" name="Shopper">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderPlaced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderCancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Support agent">
        <bpmn:flowNodeRef>Task_ShipOrderManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Tracked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Automation" name="Automation">
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChargePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PaymentCharged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PaymentRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ShipRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipOrderAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ShipMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderShipped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ConfirmationSent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PlaceOrder" name="Place order">
      <bpmn:documentation>Command Place order (El0103). Screen: Checkout (El0105). Slice Place order (Sl0001).</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_OrderPlaced" name="Order placed">
      <bpmn:documentation>Event Order placed (El0104). Feeds the Orders query (El0201).</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_Cancel" name="Shopper cancels?" default="Flow_NoCancel">
      <bpmn:documentation>Cancel order is available from the My orders screen (El0302), which reads the Orders query (El0201). The model has no arrow from Order placed to Cancel order: this branch is an interpretation.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoCancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CancelOrder" name="Cancel order">
      <bpmn:documentation>Command Cancel order (El0303). Screen: My orders (El0302, copy of El0202). Query: Orders (El0201). Slice Cancel order (Sl0003).</bpmn:documentation>
      <bpmn:incoming>Flow_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_OrderCancelled" name="Order cancelled">
      <bpmn:documentation>Event Order cancelled (El0304).</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_Split">
      <bpmn:documentation>Both automations read the Orders query (copies El0403 and El0803 of El0201), so they start together once an order is placed.</bpmn:documentation>
      <bpmn:incoming>Flow_NoCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCharge</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToConfirm</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_ChargePayment" name="Charge payment">
      <bpmn:documentation>Command Charge payment (El0402). Processor: Charge on order (El0401). Query: Orders (El0403). Slice Charge payment (Sl0004).</bpmn:documentation>
      <bpmn:incoming>Flow_ToCharge</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_PaymentCharged" name="Payment charged">
      <bpmn:documentation>Event Payment charged (El0404). Feeds the Payment status query (El0502) of the Payment provider.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_RecordPayment" name="Record payment">
      <bpmn:documentation>Command Record payment (El0503). Processor: Sync payment (El0501). Query: Payment status (El0502, Payment provider). Slice Sync payment (Sl0005).</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_PaymentRecorded" name="Payment recorded">
      <bpmn:documentation>Event Payment recorded (El0504).</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_ShipRoute" name="Shipping route" default="Flow_Auto">
      <bpmn:documentation>Ship order (El0604) has two triggers in the model: the Pick list screen (El0602) and the Auto-ship paid orders processor (El0605). Treating them as alternatives after payment is an interpretation.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
      <bpmn:outgoing>Flow_Auto</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ShipOrderManual" name="Ship order">
      <bpmn:documentation>Command Ship order (El0604). Screen: Pick list (El0602). Slice Ship order (Sl0006).</bpmn:documentation>
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ShipOrderAuto" name="Ship order">
      <bpmn:documentation>Command Ship order (El0604). Processor: Auto-ship paid orders (El0605). Slice Ship order (Sl0006).</bpmn:documentation>
      <bpmn:incoming>Flow_Auto</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ShipMerge">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_OrderShipped" name="Order shipped">
      <bpmn:documentation>Event Order shipped (El0603, Shipping events lane). Feeds the Shipment status query (El0702).</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Task_TrackShipment" name="Track shipment">
      <bpmn:documentation>Screen: Shipment tracking (El0703). Query: Shipment status (El0702). Fed by Order shipped (El0603) and the Carrier event Parcel handed over (El0701). Slice Track shipment (Sl0007, no command).</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Tracked">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_SendConfirmation" name="Send confirmation">
      <bpmn:documentation>Command Send confirmation (El0802). Processor: Send confirmation mail (El0801). Query: Orders (El0803). Slice Confirm order (Sl0008).</bpmn:documentation>
      <bpmn:incoming>Flow_ToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ConfirmationSent" name="Confirmation sent">
      <bpmn:documentation>Event Confirmation sent (El0804).</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_PlaceOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_PlaceOrder" targetRef="Event_OrderPlaced" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_OrderPlaced" targetRef="Gateway_Cancel" />
    <bpmn:sequenceFlow id="Flow_Cancel" name="yes" sourceRef="Gateway_Cancel" targetRef="Task_CancelOrder" />
    <bpmn:sequenceFlow id="Flow_NoCancel" name="no" sourceRef="Gateway_Cancel" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CancelOrder" targetRef="End_OrderCancelled" />
    <bpmn:sequenceFlow id="Flow_ToCharge" sourceRef="Gateway_Split" targetRef="Task_ChargePayment" />
    <bpmn:sequenceFlow id="Flow_ToConfirm" sourceRef="Gateway_Split" targetRef="Task_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ChargePayment" targetRef="Event_PaymentCharged" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_PaymentCharged" targetRef="Task_RecordPayment" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_RecordPayment" targetRef="Event_PaymentRecorded" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_PaymentRecorded" targetRef="Gateway_ShipRoute" />
    <bpmn:sequenceFlow id="Flow_Manual" name="manual" sourceRef="Gateway_ShipRoute" targetRef="Task_ShipOrderManual" />
    <bpmn:sequenceFlow id="Flow_Auto" name="automatic" sourceRef="Gateway_ShipRoute" targetRef="Task_ShipOrderAuto" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ShipOrderManual" targetRef="Gateway_ShipMerge" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ShipOrderAuto" targetRef="Gateway_ShipMerge" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_ShipMerge" targetRef="Event_OrderShipped" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_OrderShipped" targetRef="Task_TrackShipment" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_TrackShipment" targetRef="End_Tracked" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SendConfirmation" targetRef="End_ConfirmationSent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Carrier_di" bpmnElement="Participant_Carrier" isHorizontal="true">
        <dc:Bounds x="160" y="20" width="1880" height="60" />
