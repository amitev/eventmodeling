        <di:waypoint x="842" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCharge_di" bpmnElement="Flow_ToCharge">
        <di:waypoint x="745" y="660" />
        <di:waypoint x="810" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToConfirm_di" bpmnElement="Flow_ToConfirm">
        <di:waypoint x="720" y="685" />
        <di:waypoint x="720" y="780" />
        <di:waypoint x="810" y="780" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="910" y="660" />
        <di:waypoint x="972" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1008" y="660" />
        <di:waypoint x="1070" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1170" y="660" />
        <di:waypoint x="1232" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1268" y="660" />
        <di:waypoint x="1315" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manual_di" bpmnElement="Flow_Manual">
        <di:waypoint x="1340" y="635" />
        <di:waypoint x="1340" y="480" />
        <di:waypoint x="1420" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1348" y="540" width="40" height="14" />
        </bpmndi:BPMNLabel>
